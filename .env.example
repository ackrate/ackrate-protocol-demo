# The demo uses only OPENAI_API_KEY by default, for chat and report formatting.
# The alternate key is ignored unless failover is explicitly enabled.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set failover only when both enabled providers have working access and credit.
LLM_PROVIDER_MODE=openai-only
LLM_PRIMARY=openai

# Optional. Model ids — point these at whatever each key is provisioned for.
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_SUB=claude-sonnet-4-6
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_SUB=gpt-5.5
# Text-only marketplace reports, including the closing plain-English summary.
# Kept separate from the chat/tool model; defaults to this value when omitted.
OPENAI_REPORT_MODEL=gpt-6-astra

# Unlisted Freighter wallet + mandate-aware agent route at /wallet.
# Keep server secrets in Railway variables; never expose them with NEXT_PUBLIC_.
ACKRATE_WALLET_NETWORK=mainnet
ACKRATE_CHAT_AGENT_PUBLIC_KEY=
ACKRATE_CHAT_AGENT_SECRET=
ACKRATE_CHAT_MERCHANT_PUBLIC_KEY=
ACKRATE_CHAT_MERCHANT_URL=
ACKRATE_CHAT_MERCHANT_NAME=Research Source
ACKRATE_SESSION_SECRET=
ACKRATE_CHALLENGE_SECRET=
ACKRATE_APP_ORIGIN=https://reapp.live
ACKRATE_APP_SOURCE_COMMIT=
ACKRATE_CHAT_CATALOG_JSON=
DATABASE_URL=

# Optional one-off CLI test funding. Set only as a sealed server-side Railway
# variable for the dedicated approved burner. Never paste the phrase into Git.
# `npm start` enables the runtime hook; builds and status reads cannot start it.
ACKRATE_CLI_BURNER_MNEMONIC=

# Mainnet remains fail-closed unless this exact activation phrase is set. The
# reviewed V2 deployment manifest is pinned in source. Replacing it requires a
# code change so production cannot silently switch contract identities.
ACKRATE_ENABLE_MAINNET=ACTIVATE_VERIFIED_ACKRATE_MAINNET
